# ブログの基本設定です。

# ブログ本体とデータベースのホスト待受アドレス・ポートです。
# 既定ではこのサーバー内部だけに限定し、外部へはリバースプロキシ経由で公開します。
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=33060

# 永続化データの保存先です。
HOST_DATA_DIR=./data
WORDPRESS_HTML_DIR=./data/html
WORDPRESS_DB_DIR=./data/db_data

# リバースプロキシとつなぐためのコンテナネットワーク名と別名です。
PROXY_NETWORK_NAME=proxy-network
WORDPRESS_PROXY_ALIAS=wordpress

# コンテナ内タイムゾーンです。
TZ=Asia/Tokyo

# データベースの接続情報です。
# 初回は change-me のまま生成され、configure-default-envs.sh でも補完されます。
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
